# ==============================================================================
# CamouMacro Configuration Environment File
# ==============================================================================

# Algoritmo a ejecutar (ejemplos: allfeellove_auto, form_demo)
ALGO=allfeellove_auto

# Modo Headless: true (sin ventana gráfica) o false (con navegador visible)
HEADLESS=false

# Multiplicador de velocidad de delays (1.0 = normal, 0.5 = doble rápido, 1.5 = lento)
SPEED_FACTOR=1.0

# Puerto inicial para Tor SOCKS5
TOR_PORT=9050

# Género del objetivo a buscar ("women" o "men")
TARGET_GENDER=women

# Género de la cuenta a crear ("auto", "men" o "women")
# Si es "auto", se deduce el género opuesto al objetivo automáticamente
ACCOUNT_GENDER=auto

# Archivo de perfiles objetivo (por defecto targets/profiles_dict.txt)
TARGETS_FILE=targets/profiles_dict.txt

# Parámetros de interacción
MAX_SCAN_PAGES=100
MESSAGE_COOLDOWN_SECONDS=2.5
STICKER_COUNT=5
STICKER_INTERVAL_MS=400
